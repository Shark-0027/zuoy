# FinGuard local runtime
# Optional: point to an OpenAI-compatible chat-completions service.
# If these are empty, FinGuard runs fully in local deterministic mode.
# Set only the base URL, not "/chat/completions".
# Examples:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional full path after LLM_BASE_URL, e.g. /v3/chat/completions.
# Leave empty to auto-detect /v1/chat/completions (Ark coding uses /v3/...).
LLM_COMPLETIONS_PATH=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
# Set to 1 only if the model service needs your shell/system HTTP proxy.
LLM_TRUST_ENV=0

# Compatibility aliases. LLM_* takes priority; leave these empty if unused.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Upload / retention limits
FINGUARD_MAX_UPLOAD_MB=20
FINGUARD_MAX_FILES=8
FINGUARD_DATA_DIR=data
# Optional path overrides; on Vercel writable state defaults to /tmp/finguard.
FINGUARD_DEMO_DIR=
FINGUARD_UPLOAD_DIR=
FINGUARD_RUNTIME_DIR=
# Set to 0 to hide local filesystem paths in config/status responses.
FINGUARD_DEBUG=1

# Local server
FINGUARD_HOST=127.0.0.1
FINGUARD_PORT=8000
FINGUARD_RELOAD=0
